{
  "name": "@ticket-rpc/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @ticket-rpc/shared",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ticket-rpc/shared": "*",
    "pino": "^9.7.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.12"
  }
}