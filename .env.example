NODE_ENV=development
API_PORT=3000
DASHBOARD_PORT=5173

POSTGRES_DB=ticket_rpc
POSTGRES_USER=ticket_rpc
POSTGRES_PASSWORD=ticket_rpc_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ticket_rpc:ticket_rpc_dev@localhost:5432/ticket_rpc
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
MAX_REQUEST_BODY_SIZE=1mb
MAX_TICKET_TEXT_LENGTH=100000
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
WORKER_PROCESSING_LEASE_MS=60000
DB_RETRY_BASE_MS=500
DB_RETRY_MAX_MS=30000
DASHBOARD_ORIGIN=http://localhost:5173
LOG_LEVEL=info

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=replace_with_local_key
LLM_MODEL=replace_with_model_name
LLM_TIMEOUT_MS=30000